# Copy to backend/.env for local development. Never commit .env.

# OpenAI key (https://platform.openai.com/api-keys). In AWS this comes from SSM Parameter Store.
OPENAI_API_KEY=

# "openai" for real answers, or "fake" to run everything offline without a key (no token cost).
DOCUMIND_LLM_PROVIDER=openai

# Models are config, not code. See docs/SPEC.md for why these were chosen.
# DOCUMIND_CHAT_MODEL=gpt-6-luna
# DOCUMIND_CHAT_REASONING_EFFORT=low
# DOCUMIND_CHAT_MAX_OUTPUT_TOKENS=1000
# DOCUMIND_EMBEDDING_MODEL=text-embedding-3-small

# "memory" runs without Docker (data is lost on restart); docker-compose sets "aws" itself.
# DOCUMIND_BACKEND=memory

# DOCUMIND_LOG_LEVEL=INFO
